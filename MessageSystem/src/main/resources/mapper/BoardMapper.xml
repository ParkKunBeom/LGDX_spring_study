<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lg.myapp.mapper.BoardMapper">

	<insert id="uploadBoard" parameterType="com.lg.myapp.model.Board">
		insert into board(idx, title, writer, filename, content)
		values(board_seq.nextval, #{title}, #{writer}, #{filename}, #{content})
	</insert>
	
	<select id="boardList" resultType="com.lg.myapp.model.Board">
		select * from board order by idx asc
	</select>
	
	<select id="boardDetail" parameterType="int" resultType="com.lg.myapp.model.Board">
		select * from board where idx = #{idx}
	</select>
	
	<delete id="boardDelete" parameterType="int">
		delete from board where idx = #{idx}
	</delete>

</mapper>